clear;
close;
clc;
%% Fonction de transfert

s = tf('s');

% Paramètres physiques et électriques du MCC

Batt_Voltage = 7.2; % Tension maximale de la batterie Lego EV3
K1 = 0.01;          % Gain de conversion de U_pwm (%) à un ratio 
K2 = 0.5036;        % Constante de couple (Kt) et Constante de la force contre-électromotrice (Kb) 
K3 = K2;            % Identique au gain de rétroaction de la FCEM

% Fonction de transfert de l'induit (représente la dynamique du courant Im)
TF_inter_1 = 1/(4.7e-3*s+5.11); % 1/(Ls + R) où L=4.7e-3, R=5.11

% Fonction de transfert mécanique (représente la relation Couple -> Vitesse angulaire)
TF_inter_2 = 1/(0.0021*s + 0.0012); % 1/(Js + f) où J=0.0021, f=0.0012

% Fonction de transfert en boucle fermée de U_pwm vers la vitesse d_theta_m/dt (TF)
TF = K1*Batt_Voltage*((TF_inter_1*K2*TF_inter_2)/(1+K3*TF_inter_1*K2*TF_inter_2));

% Conversion de la FT Vitesse (TF) à la FT Position (TF2)
TF2 = TF/s; 

%% Simplification du Modèle (Réduction d'ordre)

P = pole(TF);
% Pour la simplification, on identifie le pôle le plus lent (souvent proche de 0) et on le garde.

K = dcgain(TF); % Gain statique (DC Gain)

TF_zpk = 1/(s-P(3)); 

K2 = dcgain(TF_zpk); % Gain statique du modèle 1er ordre approximé
new_K = K/K2;        % Calcul du gain constant nécessaire pour que le modèle simplifié ait le même K que le modèle complet
TF_zpk = TF_zpk*new_K; % FT Vitesse Simplifiée 

TF_U_theta = TF_zpk/s; % FT Position Simplifiée (G_U_theta)
dcgain(TF_zpk)      

%% Representation d'etat matrice compagne

% Construction des matrices à partir du dénominateur (denom(1)*s^2 + denom(2)*s + denom(3))
denom = cell2mat(TF_U_theta.Denominator);
num = cell2mat(TF_U_theta.Numerator); % Numérateur de la FT Position

A = [0 1;-denom(3) -denom(2)];  
B = [0; 1];
C = [1 0]; % La sortie y est l'état x1 (Position theta_m)
D = 0;

Sc = ss(A,B,C,D);

%% Echantillonnage

Te = 1/100; % Période d'échantillonnage de 10 ms 

% Conversion du modèle continu à un modèle discret (Sd)
Sd = c2d(Sc,Te,'zoh');

% Extraction des matrices d'état discrètes
Ad = Sd.A;
Bd = Sd.B;
Cd = Sd.C;
Dd = Sd.D;

%% Synthèse du Gain K
 
poles_souhaites = [0.9412-0.0741i 0.9412+0.0741i]; % (|z|<1), assurant la stabilité asymptotique

% Calcul du gain de retour d'état K (K_corr)
K_corr = acker(Ad,Bd,poles_souhaites);  % acker utilisée car système mono-entrée (Bd est un vecteur) et commandable

% Calcul du gain de pré-filtrage S (S_corr)
S_corr = inv(Cd*inv(eye(2)-Ad+Bd*K_corr)*Bd)

%% Retour d'état terme intégral

A_t = [A zeros(size(A));-C zeros(size(A))];
B_t = [B;-D];

K_corr_t = acker(A_t,B_t,poles_souhaites)